{
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(saasguard_api_requests_total{job=\"saasguard-api\"}[5m])) * 60",
          "legendFormat": "requests/min"
        }
      ],
      "title": "API Requests Per Minute",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(saasguard_api_requests_total{job=\"saasguard-api\",status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(saasguard_api_requests_total{job=\"saasguard-api\"}[5m])), 1)",
          "legendFormat": "api error rate"
        }
      ],
      "title": "API Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(saasguard_api_auth_failures_total{job=\"saasguard-api\"}[5m])) or vector(0)",
          "legendFormat": "auth failures"
        }
      ],
      "title": "Auth Failure Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum(increase(saasguard_worker_jobs_started_total{job=\"saasguard-worker\"}[5m])) or vector(0)",
          "legendFormat": "started"
        },
        {
          "expr": "sum(increase(saasguard_worker_jobs_completed_total{job=\"saasguard-worker\"}[5m])) or vector(0)",
          "legendFormat": "completed"
        },
        {
          "expr": "sum(increase(saasguard_worker_jobs_failed_total{job=\"saasguard-worker\"}[5m])) or vector(0)",
          "legendFormat": "failed"
        }
      ],
      "title": "Worker Job Throughput",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "oldest pending age"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 5,
      "targets": [
        {
          "expr": "sum(saasguard_export_jobs{job=\"saasguard-api\",status=\"queued\"}) or vector(0)",
          "legendFormat": "queued jobs"
        },
        {
          "expr": "sum(saasguard_export_jobs{job=\"saasguard-api\",status=\"retry_pending\"}) or vector(0)",
          "legendFormat": "retry pending"
        },
        {
          "expr": "saasguard_oldest_pending_job_age_seconds{job=\"saasguard-api\"} or vector(0)",
          "legendFormat": "oldest pending age"
        }
      ],
      "title": "Queue Backlog",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum(increase(saasguard_worker_minio_upload_failures_total{job=\"saasguard-worker\"}[5m])) or vector(0)",
          "legendFormat": "MinIO upload failures"
        },
        {
          "expr": "sum(increase(saasguard_worker_db_query_failures_total{job=\"saasguard-worker\"}[5m])) or vector(0)",
          "legendFormat": "DB query failures"
        }
      ],
      "title": "Dependency Failures",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "id": 7,
      "targets": [
        {
          "expr": "sum(increase(saasguard_api_export_requests_created_total{job=\"saasguard-api\"}[5m])) or vector(0)",
          "legendFormat": "exports requested"
        }
      ],
      "title": "Export Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "id": 8,
      "targets": [
        {
          "expr": "sum(increase(saasguard_worker_jobs_failed_total{job=\"saasguard-worker\"}[5m])) or vector(0)",
          "legendFormat": "failed"
        },
        {
          "expr": "sum(increase(saasguard_worker_job_retries_total{job=\"saasguard-worker\"}[5m])) or vector(0)",
          "legendFormat": "retries"
        }
      ],
      "title": "Worker Failures and Retries",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "id": 9,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(saasguard_api_request_latency_seconds_bucket{job=\"saasguard-api\"}[5m]))) or vector(0)",
          "legendFormat": "api p95"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(saasguard_worker_queue_wait_seconds_bucket{job=\"saasguard-worker\"}[15m]))) or vector(0)",
          "legendFormat": "queue wait p95"
        }
      ],
      "title": "Latency and Queue Wait P95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 10,
      "targets": [
        {
          "expr": "up{job=~\"saasguard-api|saasguard-worker\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "title": "Metrics Scrape Health",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["saasguard"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Service Health",
  "uid": "saasguard-service-health",
  "version": 3
}
