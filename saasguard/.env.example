APP_ENV=local
DEV_SEED_ENABLED=true
DEV_AUTH_USERNAME_FALLBACK_ENABLED=true

POSTGRES_DB=saasguard
POSTGRES_USER=saasguard
POSTGRES_PASSWORD=saasguard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=exports
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRY_SECONDS=900

APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

OIDC_ISSUER=http://auth.saasguard.local:8081/realms/saasguard
OIDC_JWKS_URL=http://auth.saasguard.local:8081/realms/saasguard/protocol/openid-connect/certs
OIDC_AUDIENCE=saasguard-api
OIDC_ALGORITHMS=RS256

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB=keycloak
KEYCLOAK_CLIENT_ID=saasguard-api
KEYCLOAK_CLIENT_SECRET=saasguard-dev-secret

WORKER_METRICS_PORT=9101
WORKER_RETRY_LIMIT=2
WORKER_RETRY_DELAY_SECONDS=10
METRICS_TENANT_LABELS_ENABLED=true

VITE_API_BASE_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://auth.saasguard.local:8081
VITE_KEYCLOAK_REALM=saasguard
VITE_KEYCLOAK_CLIENT_ID=saasguard-frontend
VITE_GRAFANA_URL=http://localhost:3000
VITE_PROMETHEUS_URL=http://localhost:9090
VITE_LOKI_URL=http://localhost:3100
